# 阿里百炼 DashScope API Key（必填）
DASHSCOPE_API_KEY=sk-your-api-key-here

# LLM 模型配置
LLM_MODEL=qwen3.5-27b
LLM_TEMPERATURE=0.1

# Embedding 配置
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# Milvus 配置（Docker 内会自动使用容器名 milvus，本地开发用 127.0.0.1）
MILVUS_URI=http://127.0.0.1:19530

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_SESSION_TTL=86400

# PostgreSQL 配置（用户认证）
DATABASE_URL=postgresql://mould:mould123@127.0.0.1:5432/mould
